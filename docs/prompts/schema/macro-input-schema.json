 {
    "type": "object",
    "description": "Market-wide macro snapshot: major indices (S&P 500, Nasdaq, VIX) and sector ETF performance summary.",
    "properties": {                                                                                                                                       
      "name": {
        "type": "string",                                                                                                                                 
        "description": "Always 'Market Overview'"                                                                                                       
      },                                                                                                                                                
      "generated_at": {                                                                                                                                   
        "type": "string",
        "description": "ISO 8601 UTC timestamp when market data was fetched"                                                                              
      },                                                                                                                                                
      "vix": {                                                                                                                                          
        "type": "object",
        "description": "CBOE Volatility Index — market fear/uncertainty gauge. Values above 20 signal elevated fear.",
        "properties": {                                                                                                                                   
          "price":          { "type": "number" },
          "open":           { "type": "number" },                                                                                                         
          "high":           { "type": "number" },                                                                                                         
          "low":            { "type": "number" },                                                                                                       
          "change":         { "type": "number" },                                                                                                         
          "change_percent": { "type": "number" },                                                                                                       
          "prev_close":     { "type": "number" }                                                                                                        
        }                                                                                                                                                 
      },
      "spy": {                                                                                                                                            
        "type": "object",                                                                                                                               
        "description": "S&P 500 proxy ETF (SPY) — broad US large-cap market performance",                                                               
        "properties": {
          "price":          { "type": "number" },                                                                                                         
          "open":           { "type": "number" },
          "high":           { "type": "number" },                                                                                                         
          "low":            { "type": "number" },                                                                                                       
          "volume":         { "type": "integer" },                                                                                                      
          "change":         { "type": "number" },
          "change_percent": { "type": "number" },                                                                                                         
          "prev_close":     { "type": "number" }
        }                                                                                                                                                 
      },                                                                                                                                                
      "qqq": {                                                                                                                                          
        "type": "object",
        "description": "Nasdaq-100 proxy ETF (QQQ) — tech-heavy growth market performance",
        "properties": {                                                                                                                                   
          "price":          { "type": "number" },
          "open":           { "type": "number" },                                                                                                         
          "high":           { "type": "number" },                                                                                                       
          "low":            { "type": "number" },                                                                                                       
          "volume":         { "type": "integer" },                                                                                                        
          "change":         { "type": "number" },
          "change_percent": { "type": "number" },                                                                                                         
          "prev_close":     { "type": "number" }                                                                                                        
        }                                                                                                                                               
      },
      "sectors_summary": {
        "type": "array",
        "description": "All 11 S&P 500 sector ETFs with price performance and news sentiment",
        "items": {                                                                                                                                        
          "type": "object",
          "properties": {                                                                                                                                 
            "sector":         { "type": "string", "description": "Sector name, e.g. 'Information Technology'" },                                        
            "etf":            { "type": "string", "description": "ETF ticker symbol, e.g. 'XLK'" },                                                       
            "price":          { "type": ["number", "null"] },
            "change_percent": { "type": ["number", "null"], "description": "% change vs previous close" },                                                
            "sentiment":      { "type": ["string", "null"], "description": "Bullish | Bearish | Neutral" }                                                
          }                                                                                                                                             
        }                                                                                                                                                 
      }                                                                                                                                                 
    }                                                                                                                                                   
  }