{
  "indicators": [
    { "type": "ema", "lengths": [9, 20, 50, 200], "output_key": "ema" },
    { "name": "rsi", "params": { "length": 14  }, "output_key": "rsi_14"  },
    { "type": "atr", "period": 14, "output_key": "atr" },

    { "type": "raw",     "source": "Close",  "offset": -1, "output_key": "prev_close"    },
    { "type": "raw",     "source": "Open",   "offset": -1, "output_key": "prev_day_open" },
    { "type": "raw",     "source": "High",   "offset": -1, "output_key": "prev_day_high" },
    { "type": "raw",     "source": "Low",    "offset": -1, "output_key": "prev_day_low"  },
    { "type": "raw",     "source": "Volume", "offset": -1, "output_key": "volume"        },

    { "type": "rolling", "source": "High",   "stat": "max",  "window": 252, "output_key": "fifty_two_week_high"  },
    { "type": "rolling", "source": "Low",    "stat": "min",  "window": 252, "output_key": "fifty_two_week_low"   },
    { "type": "rolling", "source": "Volume", "stat": "mean", "window": 20,  "output_key": "avg_daily_volume_20d", "format": "compact" },

    { "type": "session_vwap",   "session_offset": 0,                                          "output_key": "vwap_prev_session" },
    { "type": "volume_profile", "window": 252, "num_bins": 100, "value_area_pct": 70, "lookback_sessions": 3, "output_key": "volume_profile" },

    { "type": "info", "field": "marketCap",  "output_key": "market_cap", "format": "compact" },
    { "type": "info", "field": "sharesOutstanding", "output_key": "shares_outstanding", "format": "compact" },
    { "type": "beta", "timeframe": "1Y monthly", "output_key": "beta" },
    { "type": "epoch_date", "field": "earningsTimestamp", "output_key": "next_earnings_date" },
    { "type": "info", "field": "industry",   "output_key": "industry"      },
    { "type": "info", "field": "sector",     "output_key": "sector"        },
    { "type": "info", "field": "longName",   "output_key": "company_name"  },

    { "type": "premarket", "field": "price",  "output_key": "pre_market_price"  },
    { "type": "premarket", "field": "change", "output_key": "pre_market_change" },
    { "type": "premarket", "field": "volume", "output_key": "pre_market_volume" }
  ]
}
